#!/usr/bin/env bash
# Searchable list of Hyprland keybindings that have descriptions (SUPER + K).

list="$(hyprctl binds -j | jq -r '
  def mods:
    [ (if (.modmask / 64 | floor) % 2 == 1 then "SUPER" else empty end),
      (if (.modmask / 4  | floor) % 2 == 1 then "CTRL"  else empty end),
      (if (.modmask / 8  | floor) % 2 == 1 then "ALT"   else empty end),
      (if  .modmask % 2 == 1               then "SHIFT" else empty end) ];
  .[] | select((.description // "") != "")
      | ((mods + [.key]) | join(" + ")) as $k
      | ($k + (" " * ([1, 32 - ($k | length)] | max)) + .description)
')"

if command -v walker >/dev/null; then
  walker --dmenu -p "Keybindings" <<<"$list" >/dev/null
elif command -v fuzzel >/dev/null; then
  fuzzel --dmenu -p "Keybindings " --width 80 <<<"$list" >/dev/null
elif command -v rofi >/dev/null; then
  rofi -dmenu -i -p "Keybindings" <<<"$list" >/dev/null
elif command -v wofi >/dev/null; then
  wofi --dmenu -p "Keybindings" <<<"$list" >/dev/null
else
  echo "$list"
fi
