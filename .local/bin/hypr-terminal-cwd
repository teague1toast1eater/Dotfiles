#!/usr/bin/env bash
# Open a terminal in the focused terminal's working directory (like Omarchy's
# omarchy-cmd-terminal-cwd), falling back to $HOME.
#
#   hypr-terminal-cwd <terminal> [-e cmd...]   launch the terminal there
#   hypr-terminal-cwd --print                  just print the directory

focused_cwd() {
  local pid shell_pid dir
  pid="$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')"
  if [[ -n $pid && $pid != -1 ]]; then
    # The terminal's newest child process is usually the shell.
    shell_pid="$(pgrep -n -P "$pid" || true)"
    dir="$(readlink "/proc/${shell_pid:-$pid}/cwd" 2>/dev/null || true)"
  fi
  if [[ -n ${dir:-} && -d $dir ]]; then
    echo "$dir"
  else
    echo "$HOME"
  fi
}

if [[ ${1:-} == --print ]]; then
  focused_cwd
  exit 0
fi

terminal="${1:-${TERMINAL:-ghostty}}"
shift || true

cd "$(focused_cwd)" || cd "$HOME"
exec "$terminal" "$@"
